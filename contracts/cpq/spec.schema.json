{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CPQ portable spec v1 (not vendor JSON)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "engineProfile": {
      "const": "carrot-10.24.2-studio-0.7.0"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shopRef": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "languageRef": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "priceBasis": {
          "enum": [
            "ex-vat",
            "inc-vat"
          ]
        },
        "decimalPlaces": {
          "const": 2
        },
        "rounding": {
          "enum": [
            "half-up",
            "half-even"
          ]
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        },
        "erp": {
          "const": "none"
        }
      },
      "required": [
        "shopRef",
        "languageRef",
        "currency",
        "priceBasis",
        "decimalPlaces",
        "rounding",
        "quantity",
        "erp"
      ]
    },
    "catalogue": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "price": {
            "type": "string",
            "pattern": "^(?:0|[1-9][0-9]*)\\.[0-9]{2}$"
          },
          "cost": {
            "type": "string",
            "pattern": "^(?:0|[1-9][0-9]*)\\.[0-9]{2}$"
          },
          "attributes": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            },
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            }
          }
        },
        "required": [
          "key",
          "price",
          "cost"
        ]
      },
      "minItems": 1
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "key",
          "label",
          "order"
        ]
      },
      "minItems": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "group": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "type": {
            "enum": [
              "button",
              "buttonGroup",
              "checkbox",
              "checkboxLarge",
              "colorselector",
              "date",
              "select",
              "longtext",
              "lookup",
              "number",
              "popup",
              "radio",
              "radiobox",
              "richtext",
              "separator",
              "text",
              "toggle"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "default": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "value": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "image": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "value",
                "label"
              ]
            },
            "minItems": 1
          },
          "lookup": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "step": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "maxLength": {
            "type": "integer",
            "minimum": 1
          },
          "use": {
            "enum": [
              "value",
              "display-only"
            ]
          }
        },
        "required": [
          "key",
          "group",
          "type"
        ]
      },
      "minItems": 1
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "value": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "key",
          "value"
        ]
      },
      "minItems": 0
    },
    "lookups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "source": {
            "const": "catalogue"
          },
          "valueField": {
            "const": "key"
          },
          "labelField": {
            "enum": [
              "key"
            ]
          },
          "where": {
            "$ref": "#/definitions/condition"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        },
        "required": [
          "key",
          "source",
          "valueField",
          "labelField",
          "where",
          "limit"
        ]
      },
      "minItems": 0
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]*$"
          },
          "when": {
            "$ref": "#/definitions/condition"
          },
          "require": {
            "$ref": "#/definitions/condition"
          },
          "onConflict": {
            "enum": [
              "clear-dependent-and-invalidate",
              "reject"
            ]
          }
        },
        "required": [
          "id",
          "when",
          "require",
          "onConflict"
        ]
      },
      "minItems": 0
    },
    "inputRules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]*$"
          },
          "order": {
            "type": "integer",
            "minimum": 0
          },
          "when": {
            "$ref": "#/definitions/condition"
          },
          "then": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/action"
            },
            "minItems": 1
          },
          "else": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/action"
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "order",
          "when",
          "then",
          "else"
        ]
      },
      "minItems": 0
    },
    "bom": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]*$"
          },
          "when": {
            "$ref": "#/definitions/condition"
          },
          "sku": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "quantity": {
            "oneOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0
              },
              {
                "type": "string",
                "pattern": "^\\$(?:input|variable)\\.[A-Za-z][A-Za-z0-9_-]*$"
              }
            ]
          }
        },
        "required": [
          "id",
          "sku",
          "quantity"
        ]
      },
      "minItems": 1
    },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {
          "const": "catalogue-sell"
        },
        "additionalMarkupPercent": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9.-]*$"
              },
              "order": {
                "type": "integer",
                "minimum": 0
              },
              "when": {
                "$ref": "#/definitions/condition"
              },
              "discountPercent": {
                "type": "string",
                "pattern": "^(?:0|[1-9][0-9]*)\\.[0-9]{2}$"
              }
            },
            "required": [
              "id",
              "order",
              "when",
              "discountPercent"
            ]
          },
          "minItems": 0
        }
      },
      "required": [
        "method",
        "additionalMarkupPercent",
        "rules"
      ]
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "navigationTag": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "theme": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "tabs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "optionColumns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        }
      },
      "required": [
        "navigationTag",
        "theme",
        "tabs",
        "optionColumns"
      ]
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "persistence": {
          "const": "card"
        },
        "handoff": {
          "type": "array",
          "items": {
            "enum": [
              "cart",
              "local-quote"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "document": {
          "enum": [
            "local-docx",
            "none"
          ]
        },
        "routing": {
          "const": false
        },
        "visual3d": {
          "const": false
        }
      },
      "required": [
        "persistence",
        "handoff",
        "document",
        "routing",
        "visual3d"
      ]
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]*$"
          },
          "answers": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            },
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            }
          },
          "expect": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "valid": {
                "type": "boolean"
              },
              "bom": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
                },
                "additionalProperties": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "minProperties": 1
              },
              "sell": {
                "type": "string",
                "pattern": "^(?:0|[1-9][0-9]*)\\.[0-9]{2}$"
              },
              "beforeDiscount": {
                "type": "string",
                "pattern": "^(?:0|[1-9][0-9]*)\\.[0-9]{2}$"
              },
              "canPersist": {
                "type": "boolean"
              },
              "canHandoff": {
                "type": "boolean"
              }
            },
            "required": [
              "valid"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "valid": {
                      "const": true
                    }
                  }
                },
                "then": {
                  "required": [
                    "bom",
                    "sell"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "valid": {
                      "const": false
                    }
                  }
                },
                "then": {
                  "required": [
                    "canPersist",
                    "canHandoff"
                  ],
                  "properties": {
                    "canPersist": {
                      "const": false
                    },
                    "canHandoff": {
                      "const": false
                    }
                  },
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "sell"
                        ]
                      },
                      {
                        "required": [
                          "bom"
                        ]
                      },
                      {
                        "required": [
                          "beforeDiscount"
                        ]
                      }
                    ]
                  }
                }
              }
            ]
          }
        },
        "required": [
          "id",
          "answers",
          "expect"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "version",
    "engineProfile",
    "context",
    "catalogue",
    "groups",
    "inputs",
    "constraints",
    "inputRules",
    "bom",
    "pricing",
    "page",
    "output",
    "cases"
  ],
  "definitions": {
    "value": {
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "items": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "minItems": 0
        }
      ]
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "eq": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/value"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "eq"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "neq": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/value"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "neq"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "gt": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/value"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "gt"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "gte": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/value"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "gte"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lt": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/value"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "lt"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lte": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/value"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "lte"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "contains": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/value"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "contains"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "startswith": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/value"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "startswith"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "endswith": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/value"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "endswith"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "in": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/value"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "in"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "nin": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/value"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "nin"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hasvalue": {
              "$ref": "#/definitions/value"
            }
          },
          "required": [
            "hasvalue"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "and": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/condition"
              },
              "minItems": 1
            }
          },
          "required": [
            "and"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "or": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/condition"
              },
              "minItems": 1
            }
          },
          "required": [
            "or"
          ]
        }
      ]
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowOptions": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "input": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
                },
                "values": {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  },
                  "minItems": 1,
                  "uniqueItems": true
                }
              },
              "required": [
                "input",
                "values"
              ]
            }
          },
          "required": [
            "allowOptions"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "set": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "input": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
                },
                "value": {
                  "$ref": "#/definitions/value"
                }
              },
              "required": [
                "input",
                "value"
              ]
            }
          },
          "required": [
            "set"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "properties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "input": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
                },
                "visible": {
                  "type": "boolean"
                },
                "enabled": {
                  "type": "boolean"
                },
                "required": {
                  "type": "boolean"
                },
                "readOnly": {
                  "type": "boolean"
                }
              },
              "required": [
                "input"
              ],
              "minProperties": 2
            }
          },
          "required": [
            "properties"
          ]
        }
      ]
    }
  }
}
