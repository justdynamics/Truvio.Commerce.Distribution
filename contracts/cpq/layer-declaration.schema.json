{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CPQ layer-owned contract paths v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "spec": {
      "type": "string",
      "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?!/)[A-Za-z0-9_-]+(?:/[A-Za-z0-9_.-]+)*\\.json$"
    },
    "packages": {
      "type": "string",
      "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?!/)[A-Za-z0-9_-]+(?:/[A-Za-z0-9_.-]+)*\\.json$"
    },
    "behavior": {
      "type": "string",
      "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?!/)[A-Za-z0-9_-]+(?:/[A-Za-z0-9_.-]+)*\\.json$"
    },
    "status": {
      "enum": [
        "candidate",
        "ready"
      ]
    },
    "blockers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]+$"
          },
          "reason": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "candidateArtifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compiled",
        "identityMap",
        "content",
        "cases"
      ],
      "properties": {
        "compiled": {
          "type": "string",
          "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?!/)[A-Za-z0-9_-]+(?:/[A-Za-z0-9_.-]+)*\\.json$"
        },
        "identityMap": {
          "type": "string",
          "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?!/)[A-Za-z0-9_-]+(?:/[A-Za-z0-9_.-]+)*\\.json$"
        },
        "content": {
          "type": "string",
          "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?!/)[A-Za-z0-9_-]+(?:/[A-Za-z0-9_.-]+)*\\.json$"
        },
        "cases": {
          "type": "string",
          "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?!/)[A-Za-z0-9_-]+(?:/[A-Za-z0-9_.-]+)*\\.json$"
        }
      }
    }
  },
  "required": [
    "schemaVersion",
    "spec",
    "packages",
    "behavior"
  ],
  "allOf": [
    {
      "if": {
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "candidate"
          }
        }
      },
      "then": {
        "required": [
          "blockers",
          "candidateArtifacts"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "blockers"
              ]
            },
            {
              "required": [
                "candidateArtifacts"
              ]
            }
          ]
        }
      }
    }
  ]
}
