{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CPQ behavior row payload v1",
  "description": "The `observed` object of one receipt row. Written by the bounded experiment producer and read by the registered receipt reader; both validate against this file. Sanitized observation data, not executable instructions.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "operation": {
      "description": "The step this row's check is judged on. Must equal the operation of the check's function (Get-CpqCheckOperation).",
      "$ref": "#/definitions/operation"
    },
    "steps": {
      "description": "The case's step journal, in execution order: a prefix of render, recalculate, save, reopen, revision, cart, quote, document. Only the last recorded step may be other than PASS.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "render": {
          "$ref": "#/definitions/step"
        },
        "recalculate": {
          "$ref": "#/definitions/step"
        },
        "save": {
          "$ref": "#/definitions/step"
        },
        "reopen": {
          "$ref": "#/definitions/step"
        },
        "revision": {
          "$ref": "#/definitions/step"
        },
        "cart": {
          "$ref": "#/definitions/step"
        },
        "quote": {
          "$ref": "#/definitions/step"
        },
        "document": {
          "$ref": "#/definitions/step"
        }
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "operation",
    "steps",
    "reason"
  ],
  "definitions": {
    "operation": {
      "enum": [
        "render",
        "recalculate",
        "save",
        "reopen",
        "revision",
        "cart",
        "quote",
        "document"
      ]
    },
    "money": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.[0-9]{2}$"
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "result": {
          "enum": [
            "PASS",
            "FAIL",
            "ERROR",
            "UNVERIFIED"
          ]
        },
        "read": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "surface": {
              "enum": [
                "mcp",
                "admin-api",
                "runtime",
                "file",
                "sql"
              ]
            },
            "operation": {
              "type": "string",
              "minLength": 1
            },
            "complete": {
              "const": true
            },
            "nextCursor": {
              "const": null
            },
            "expectedSubjects": {
              "type": "integer",
              "minimum": 1
            },
            "observedSubjects": {
              "type": "integer",
              "minimum": 1
            },
            "localOnly": {
              "type": "boolean"
            }
          },
          "required": [
            "complete",
            "nextCursor",
            "expectedSubjects",
            "observedSubjects"
          ]
        },
        "observed": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hostId": {
              "type": "string",
              "minLength": 1
            },
            "caseId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9.-]*$"
            },
            "modelVersionId": {
              "type": "integer",
              "minimum": 1
            },
            "erpCalls": {
              "const": 0
            },
            "rendered": {
              "type": "boolean"
            },
            "dwErrors": {
              "type": "integer",
              "minimum": 0
            },
            "theme": {
              "type": "string",
              "minLength": 1
            },
            "valid": {
              "type": "boolean"
            },
            "bom": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
              },
              "additionalProperties": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "sell": {
              "$ref": "#/definitions/money"
            },
            "beforeDiscount": {
              "$ref": "#/definitions/money"
            },
            "destinationId": {
              "type": "string",
              "minLength": 1
            },
            "readBack": {
              "type": "boolean"
            },
            "ownerVerified": {
              "type": "boolean"
            }
          },
          "required": [
            "hostId",
            "caseId",
            "modelVersionId",
            "erpCalls"
          ]
        }
      },
      "required": [
        "result",
        "read",
        "observed"
      ]
    }
  }
}
