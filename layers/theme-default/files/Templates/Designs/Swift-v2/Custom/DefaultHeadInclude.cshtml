@inherits Dynamicweb.Rendering.ViewModelTemplate<Dynamicweb.Frontend.PageViewModel>
@using Dynamicweb.Frontend
@using System.Linq
@{
    AddStylesheet("/Files/Templates/Designs/Swift-v2/Custom/default_custom.css", "all");
    // The add-on slot. An opt-in layer (kind feature) cannot edit this file: the theme's
    // copy wins every shared path on delivery. So an add-on ships its own folder,
    // Custom/Addons/<name>/, with addon.css and/or addon.js, and this include registers
    // whatever is on disk, in folder-name order. No folder, nothing registered: a host
    // without add-ons renders exactly as before. Add-on sheets load after the theme sheet
    // and before brand.css, so the brand still wins a cascade tie.
    const string addonRoot = "/Files/Templates/Designs/Swift-v2/Custom/Addons";
    var addonDir = Dynamicweb.Context.Current.Server.MapPath(addonRoot);
    var addons = System.IO.Directory.Exists(addonDir)
        ? System.IO.Directory.GetDirectories(addonDir).Select(System.IO.Path.GetFileName).OrderBy(n => n, StringComparer.OrdinalIgnoreCase).ToList()
        : new System.Collections.Generic.List<string>();
    foreach (var addon in addons)
    {
        if (System.IO.File.Exists(System.IO.Path.Combine(addonDir, addon, "addon.css")))
        {
            AddStylesheet(addonRoot + "/" + addon + "/addon.css", "all");
        }
    }
    // The brand slot. brand.css belongs to the demo: a build rewrites it (and
    // brand.tokens.json beside it) in a demo-local copy of this layer instead of
    // appending brand rules to default_custom.css. Registered AFTER the theme sheet
    // so a brand rule wins a cascade tie without !important. Ships with no paint.
    AddStylesheet("/Files/Templates/Designs/Swift-v2/Custom/brand.css", "all");
    // The theme's JavaScript entry point. It ships EMPTY and registering it changes
    // nothing about the rendered page — that is the point: a consumer adding behaviour
    // edits a file that is already served instead of creating one and wiring it up.
    // defer: true keeps it after the design package's own scripts and after parse.
    // The platform helper is AddScript(path, defer:bool) - there is no AddJavascript
    // on DW 10.28.10, and calling one does not compile: every page renders a dw-error
    // dump instead of the site (e2e v5, DW 10.28.10).
    AddScript("/Files/Templates/Designs/Swift-v2/Custom/default_custom.js", true);
    foreach (var addon in addons)
    {
        if (System.IO.File.Exists(System.IO.Path.Combine(addonDir, addon, "addon.js")))
        {
            AddScript(addonRoot + "/" + addon + "/addon.js", true);
        }
    }
}
<style>
    /* Render-critical neutral tokens — inline to avoid cache-buster staleness (Pitfall 7).
       SECOND BINDING SITE (Foundry #34): these declarations are a COPY of the token block
       in default_custom.css. Renaming or retiring a token in the sheet alone leaves this
       block as its only definition, so every consumer silently keeps the retired value.
       Change both in one pass, and retire a token by ALIASING it to its successor with
       !important (never by deleting it) — see the convention block in default_custom.css. */
    :root {
        --td-ink:         #1F2933;
        --td-ink-soft:    #323F4B;
        --td-slate:       #3E4C59;
        --td-slate-mid:   #52606D;
        --td-slate-light: #CBD2D9;
        --td-white:       #FFFFFF;
    }
</style>
@*
    RAW HEAD-INJECTION POINT (Part B-6).
    The Swift master's CustomHeadInclude *field* HTML-encodes its value, which blocks
    JSON-LD / structured-data / raw <meta> injection at the design layer. This design-
    package head-include renders through Razor, so it is the raw (unencoded) output
    point: emit head markup here with @@Html.Raw(...) and it reaches the <head> verbatim.
    theme-default ships NO injected markup — the block below is an inert, copy-ready
    example a consuming solution fills in (product JSON-LD, Open Graph, verification
    meta, etc.). Leaving it commented keeps the default demo's head clean.

    Example (uncomment + populate in the consuming solution):
    @@{
        var jsonLd = "{\"@@context\":\"https://schema.org\",\"@@type\":\"Organization\"}";
    }
    @@Html.Raw("<script type=\"application/ld+json\">" + jsonLd + "</script>")
*@
