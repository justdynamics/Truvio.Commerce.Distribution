{
  "name": "sample-data",
  "version": "5.0.1",
  "kind": "sample-data",
  "swiftVersion": "2.4.0",
  "repositoryName": "Products",
  "fragmentModes": [
    "replace",
    "merge"
  ],
  "fragmentTables": [
    "AccessUser",
    "AccessUserGroupRelation",
    "AccessUserSecondaryRelation",
    "EcomShops",
    "EcomShopLanguageRelation",
    "EcomCompletionRules",
    "EcomGroups",
    "EcomShopGroupRelation",
    "EcomGroupRelations",
    "EcomVariantGroups",
    "EcomVariantsOptions",
    "EcomProducts",
    "EcomGroupProductRelation",
    "EcomVariantGroupProductRelation",
    "EcomVariantOptionsProductRelation",
    "EcomPrices",
    "EcomProductItems",
    "EcomProductCategory",
    "EcomProductCategoryTranslation",
    "EcomProductField",
    "EcomProductCategoryField",
    "EcomProductCategoryFieldTranslation",
    "EcomProductCategoryFieldValue",
    "EcomFieldDisplayGroups",
    "EcomFieldDisplayGroupTranslation",
    "EcomFieldDisplayGroupFields",
    "EcomDetailsGroup",
    "EcomDetails",
    "EcomProductsRelatedGroups",
    "EcomProductsRelated",
    "EcomStockUnit",
    "EcomOrders",
    "EcomOrderLines",
    "DynamicStructures",
    "DynamicStructureLevels"
  ],
  "configRows": [
    {
      "table": "EcomProducts",
      "where": "ProductId = 'TCPROD0001' AND ProductLanguageId = 'ENU'",
      "description": "The first Variants master in the brand catalogue, the PDP the demo opens first (variant selector, spec table, documents, gallery, related strip). Proves the merge deserialize landed the catalogue rows."
    },
    {
      "table": "AccessUser",
      "where": "AccessUserId = '100100' AND AccessUserUserAndGroupType = 'SystemAccount'",
      "description": "Foundry #1261 (arm B): the account group carries the SystemAccount user-and-group type, the ListGroupType the Swift CSR Accounts app (UserGroups) filters on. Untyped, the demo account never lists for the CSR persona."
    },
    {
      "table": "AccessUserSecondaryRelation",
      "where": "AccessUserSecondaryRelationUserId = '1292' AND AccessUserSecondaryRelationSecondaryUserId = '100100'",
      "description": "Foundry #1261 (arm B): the impersonation grant of the base-contract CSR group 1292 over the account group 100100, which is what fills CSR Users and lets the CSR persona impersonate the buyer."
    },
    {
      "table": "EcomPrices",
      "where": "PriceId = 'TC-PRICE-VAR-0006' AND PriceProductVariantId = 'TCVO-TIER-ENT.TCVO-MODE-PUB' AND PriceAmount = '79.2'",
      "description": "Foundry #1254 (arm B): the per-combination list row of TCPROD0001 ENT.PUB, which resolves only because the variant master ships no master-level list or customer-group row any more (the lowest matching row wins, and an unkeyed 45 undercut every combination)."
    },
    {
      "table": "AccessUser",
      "where": "AccessUserId = '100101'",
      "description": "The buyer persona buyer@truvio-demo.example at its reserved int id above the 100000 floor. Its password is not in the data: Foundry tools/secrets/Set-DemoCredential.ps1 sets it online through Management API UserSetPassword."
    },
    {
      "table": "EcomDetailsGroup",
      "where": "EcomDetailsGroupSystemName = 'Manuals'",
      "description": "The Manuals asset category (reserved id 100111) that Swift's ProductMediaTable binds to by system name for the PDP documents table."
    },
    {
      "table": "EcomFieldDisplayGroups",
      "where": "FieldDisplayGroupSystemName = 'tc_specs'",
      "description": "The tc_specs field display group (reserved id 100120) the surface-swift PDP spec table binds to by system name."
    },
    {
      "table": "EcomOrders",
      "where": "OrderId = 'TCO-0012'",
      "description": "The last of the twelve buyer orders TCO-0001..TCO-0012 the my-orders page lists."
    },
    {
      "table": "EcomProducts",
      "where": "ProductId = 'TCPROD0061' AND ProductLanguageId = 'ENU'",
      "description": "The subscription plan TC-SUB-0061 in TCGRP-PRICE-STRUCTURES, the product feature-subscription-orders' checkout-recurring probe buys."
    },
    {
      "table": "EcomOrders",
      "where": "OrderId = 'TCO-0001' AND OrderPriceWithVAT = '195'",
      "description": "Foundry #1239: the first buyer order carries the VAT-split price columns Swift's My orders and order detail actually read, not only OrderTotalPrice. 195 EUR is the line sum (60 x 2 + 75 x 1) at the layer's OrderVAT 0, so WithVAT = WithoutVAT = 195 and VAT = 0. Proves the delivered rows already total without an OrderRecalculate pass."
    },
    {
      "table": "EcomProductField",
      "where": "ProductFieldId = 'TCFIELD-PRODUCTNUMBER' AND ProductFieldAllowChangesAcrossVariants = '1'",
      "description": "Foundry #1253 (arm B): variant editing ON for ProductNumber, one of the six product fields DW 10.28 keeps master-only by default. Without it the first master save through any API copies the master's number, price and stock onto all 36 variant rows this layer ships. Proves the six TCFIELD-* settings rows landed."
    },
    {
      "table": "EcomShops",
      "where": "ShopId = 'TCSHOP-PIM' AND ShopType = '4'",
      "description": "5.0.0: the DataStructure shop that owns the data-model tree. ShopType 4 is the whole discriminator - the admin's Data models section lists ShopType 4 shops and nothing else, so a shop that lands as ShopType 1 puts the data models in the Channels tree beside the storefront and the PIM demo has no home."
    },
    {
      "table": "EcomGroups",
      "where": "GroupId = 'TCDM-COMMERCE' AND GroupType = '2' AND ProductCategoryId = 'tc_commerce'",
      "description": "5.0.0: a DataModel group carries BOTH its type and its category. GroupType 2 is what makes it a data model rather than a catalog group (NULL defaults to 0, Common), and ProductCategoryId is what plumbs the category's seven fields to the products related to it. Either one missing and the group still renders, still relates products and still reads back through every MCP group tool - it just does nothing."
    },
    {
      "table": "EcomGroupProductRelation",
      "where": "GroupProductRelationGroupId = 'TCDM-COMMERCE' AND GroupProductRelationProductId = 'TCPROD0006' AND GroupProductRelationIsPrimary = '0'",
      "description": "5.0.0: one of the 61 master-to-data-model relations, proving the band mapping landed AND that it is non-primary. A data-model relation that arrives primary would move the master's canonical home out of its catalogue subgroup and off the storefront URL."
    },
    {
      "table": "EcomProductCategoryField",
      "where": "FieldCategoryId = 'reference_category' AND FieldId = 'tcMaterialClass'",
      "description": "5.0.0: one of the 28 reference_category mirror fields. The mirror is the half of DW's completeness plumbing with no visible symptom when it is missing - rules validate, assignments persist, the API answers correctly, and the admin completeness panel on the product renders EMPTY. The parent reference_category row is base-owned (base 3.6.0)."
    },
    {
      "table": "EcomCompletionRules",
      "where": "EcomCompletionRuleId = '100160' AND EcomCompletionRuleExcludeVariants = '1'",
      "description": "5.0.0: the Commerce data model's completion rule at its reserved identity, with variants excluded. Its EcomCompletionRuleProductFields names the seven tc_commerce fields in the AUTHORING form ProductCategory|tc_commerce|<field>; the index-side form CustomField_<name> matches nothing in a rule definition."
    },
    {
      "table": "DynamicStructures",
      "where": "DynamicStructureId = '100170'",
      "description": "5.0.0: the one Dynamic Workspace, 'Truvio PIM - by data model'. Its DynamicStructureQueryId is the Id GUID of repositories/TruvioCommerce/PimWorkspace.query, which this layer also ships, and its DynamicStructureUniqueId is what the two DynamicStructureLevels rows join on. A workspace whose query GUID resolves to no file opens and lists nothing."
    }
  ],
  "sql": [
    {
      "file": "_sql/email-stats.sql",
      "mode": "merge",
      "phase": "after-replace-deserialize",
      "order": 1,
      "description": "Email-marketing statistics backfill: per campaign email a send-log message, 24 recipients (2 bounced), 3 tracked links and 13 clicks, so the backend Marketing dashboards do not read 0 sent / 0 clicked. Discovery-driven, and a clean no-op when the composition ships no campaign emails.",
      "idempotent": true,
      "transactional": true,
      "requiresHostRestart": false
    },
    {
      "file": "_sql/demo-clock.sql",
      "mode": "merge",
      "phase": "after-replace-deserialize",
      "order": 2,
      "description": "The demo clock: the _demoClock anchor table (anchored to the harvest day 2026-09-13 the serialized rows carry), the exclusion and per-column guard tables, usp_DemoClockShift (discovers every operational date column from sys.columns and shifts it by whole days), and the daily RunSql scheduled task that runs it. Keeps the brand orders TCO-0001..TCO-0012 and every other seeded date anchored to today.",
      "idempotent": true,
      "transactional": true,
      "requiresHostRestart": true
    },
    {
      "file": "_sql/number-counters.sql",
      "mode": "merge",
      "phase": "after-merge-deserialize",
      "order": 1,
      "description": "EcomNumbers counters raised past the ids the composition's layers ship (Foundry #1322): for every counter that names its table and id column, NumberCounter is raised to the highest <prefix><digits><postfix> id in use, never lowered. A deserialize writes ids verbatim and never advances a counter, so without it the next create without an explicit id (an order state, shipping, payment or price) mints an id that exists and overwrites the shipped row. Table-agnostic, so the base's OS/SHIP/PAY rows and every other counter are covered. Local installs only; an online host applies it through its own SQL route.",
      "idempotent": true,
      "transactional": true,
      "requiresHostRestart": true
    }
  ],
