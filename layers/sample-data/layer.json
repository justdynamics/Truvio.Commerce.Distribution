{
  "name": "sample-data",
  "version": "4.0.0",
  "kind": "sample-data",
  "swiftVersion": "2.4.0",
  "repositoryName": "Products",
  "fragmentModes": [
    "replace",
    "merge"
  ],
  "fragmentTables": [
    "AccessUser",
    "AccessUserGroupRelation",
    "EcomGroups",
    "EcomShopGroupRelation",
    "EcomGroupRelations",
    "EcomVariantGroups",
    "EcomVariantsOptions",
    "EcomProducts",
    "EcomGroupProductRelation",
    "EcomVariantGroupProductRelation",
    "EcomVariantOptionsProductRelation",
    "EcomPrices",
    "EcomProductItems",
    "EcomProductCategory",
    "EcomProductCategoryTranslation",
    "EcomProductCategoryField",
    "EcomProductCategoryFieldTranslation",
    "EcomProductCategoryFieldValue",
    "EcomFieldDisplayGroups",
    "EcomFieldDisplayGroupTranslation",
    "EcomFieldDisplayGroupFields",
    "EcomDetailsGroup",
    "EcomDetails",
    "EcomProductsRelatedGroups",
    "EcomProductsRelated",
    "EcomStockUnit",
    "EcomOrders",
    "EcomOrderLines"
  ],
  "configRows": [
    {
      "table": "EcomProducts",
      "where": "ProductId = 'TCPROD0001' AND ProductLanguageId = 'ENU'",
      "description": "The first Variants master in the brand catalogue, the PDP the demo opens first (variant selector, spec table, documents, gallery, related strip). Proves the merge deserialize landed the catalogue rows."
    },
    {
      "table": "AccessUser",
      "where": "AccessUserId = '100101'",
      "description": "The buyer persona buyer@truvio-demo.example at its reserved int id above the 100000 floor. Its password is not in the data: Foundry tools/secrets/Set-DemoCredential.ps1 sets it online through Management API UserSetPassword."
    },
    {
      "table": "EcomDetailsGroup",
      "where": "EcomDetailsGroupSystemName = 'Manuals'",
      "description": "The Manuals asset category (reserved id 100111) that Swift's ProductMediaTable binds to by system name for the PDP documents table."
    },
    {
      "table": "EcomFieldDisplayGroups",
      "where": "FieldDisplayGroupSystemName = 'tc_specs'",
      "description": "The tc_specs field display group (reserved id 100120) the surface-swift PDP spec table binds to by system name."
    },
    {
      "table": "EcomOrders",
      "where": "OrderId = 'TCO-0012'",
      "description": "The last of the twelve buyer orders TCO-0001..TCO-0012 the my-orders page lists."
    },
    {
      "table": "EcomProducts",
      "where": "ProductId = 'TCPROD0061' AND ProductLanguageId = 'ENU'",
      "description": "The subscription plan TC-SUB-0061 in TCGRP-PRICE-STRUCTURES, the product feature-subscription-orders' checkout-recurring probe buys."
    }
  ],
  "sql": [
    {
      "file": "_sql/email-stats.sql",
      "mode": "merge",
      "phase": "after-replace-deserialize",
      "order": 1,
      "description": "Email-marketing statistics backfill: per campaign email a send-log message, 24 recipients (2 bounced), 3 tracked links and 13 clicks, so the backend Marketing dashboards do not read 0 sent / 0 clicked. Discovery-driven, and a clean no-op when the composition ships no campaign emails.",
      "idempotent": true,
      "transactional": true,
      "requiresHostRestart": false
    },
    {
      "file": "_sql/demo-clock.sql",
      "mode": "merge",
      "phase": "after-replace-deserialize",
      "order": 2,
      "description": "The demo clock: the _demoClock anchor table (anchored to the harvest day 2026-09-13 the serialized rows carry), the exclusion and per-column guard tables, usp_DemoClockShift (discovers every operational date column from sys.columns and shifts it by whole days), and the daily RunSql scheduled task that runs it. Keeps the brand orders TCO-0001..TCO-0012 and every other seeded date anchored to today.",
      "idempotent": true,
      "transactional": true,
      "requiresHostRestart": true
    }
  ],
