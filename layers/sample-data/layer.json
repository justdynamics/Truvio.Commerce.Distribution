      "EcomPrices": 221,
      "EcomProductCategory": 4,
      "EcomProductCategoryField": 56,
      "EcomProductCategoryFieldTranslation": 56,
      "EcomProductCategoryFieldValue": 427,
      "EcomProductCategoryTranslation": 4,
      "EcomProductField": 6,
      "EcomProductItems": 10,
      "EcomProducts": 97,
      "EcomProductsRelated": 326,
      "EcomProductsRelatedGroups": 3,
      "EcomShopGroupRelation": 21,
      "EcomShopLanguageRelation": 1,
      "EcomShops": 1,
      "EcomStockUnit": 61,
      "EcomVariantGroupProductRelation": 12,
