@inherits Dynamicweb.Rendering.ViewModelTemplate<Dynamicweb.Frontend.ParagraphViewModel>
@using Dynamicweb.Frontend

@{
	// Foundry #1185: the fallback title is the area name, what a site is actually called, and it is
	// what the raster <img> alt below reads when the logo paragraph carries no LogoName. Swift 2.5
	// adopts the same fallback; the null-conditional keeps a render with no area from throwing.
	string title = Model.Item.TryGetString("LogoName", out string logoName) && !string.IsNullOrWhiteSpace(logoName)
		? logoName
		: Pageview?.Area?.Name ?? string.Empty;

	string homePageLink = "/";
	if (Model.Item.TryGetLink("Link", out LinkViewModel link)) {
		homePageLink = link.Url;
	}
}

<div class="d-flex position-relative">
	@if (Model.Item.TryGetImageFile("Image", out ImageFileViewModel image)) {	
		if (Model.Item.TryGetString("LogoWidth", out string logoWidth)) {
			logoWidth = $"width:{logoWidth}px";
		}
		if (image.IsSvg()) {
			<figure class="icon-auto m-0" style="@logoWidth">
				@ReadFile(image.Path)
			</figure>
		}
		else 
		{
			<figure class="m-0">
				@* Foundry #1185: Swift 2.4 wrote alt="@image.Path" (a screen reader announced the file path)
				   and Swift 2.5 writes alt="". The overlay keeps the title as alt, so a raster wordmark is
				   announced by the site name. *@
				<img src="@image.Path" alt="@title" style="@logoWidth">
			</figure>
		}
	}
	else 
	{
		<span class="fs-4">@title</span>
	}
	<a href="@homePageLink" class="stretched-link" title="@title"></a>
</div>
