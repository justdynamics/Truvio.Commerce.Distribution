@inherits ViewModelTemplate<ParagraphViewModel>
@using Dynamicweb.Rendering
@using Dynamicweb.Frontend

@{
    // Truvio surface-swift (Foundry #1395): an account admin, base permission group 1270, reads the
    // whole account, every order on the admin's customer number (RetrieveMode=useCustomerNumber).
    // Every other user keeps the stock self scope, the API default useUserId.
    var dashboardUser = Dynamicweb.Security.UserManagement.UserContext.Current.User;
    var retrieveMode = dashboardUser != null && dashboardUser.HasGroup(1270) && !string.IsNullOrEmpty(dashboardUser.CustomerNumber) ? "RetrieveMode=useCustomerNumber&" : string.Empty;
    var widgetTitle = Model?.Item?.GetString("Title") ?? Translate("Spent this month");
    var baseUrl = string.Empty;
    var icon = "/Files/Images/Icons/dollar.svg";
    
    if((Model?.Item?.TryGetLink("BaseLink", out var baseLinkViewModel) ?? false)) {
        baseUrl = baseLinkViewModel.Url;
        var basePageId = baseLinkViewModel?.PageId ?? 0;
        var basePage = Dynamicweb.Content.Services.Pages.GetPage(basePageId);
        var basePageIcon = basePage?.Icon;
        icon = !string.IsNullOrEmpty(basePageIcon) ? basePageIcon : icon;
    }    

    var ToDate = DateTime.UtcNow;
    var FromDate = ToDate.AddDays(1 - ToDate.Day).Date;
}

<div class="card h-100" style="--swift-content-padding: 1.25rem;">
    <div class="card-body">
        <div class="hstack flex-wrap gap-2 mb-2">
            <div class="d-grid p-2 rounded-2 bg-success bg-opacity-10">
                <span class="icon fs-5 text-success">@ReadFile(icon)</span>
            </div>
            <span class="fs-7 fw-semibold text-body text-opacity-75">@(widgetTitle)</span>
        </div>
        <div data-swift-htmx-widget="@(Model?.ID)"
            hx-get="/dwapi/ecommerce/orders/search?@(retrieveMode)Type=order&PageSize=999&ShopId=@(Pageview?.Area?.EcomShopId)&ToCompletedDate=@(DateTime.Now.AddDays(1).ToString("yyyy-MM-dd"))"
            hx-vals='{"FromCompletedDate": "@(FromDate.ToString("yyyy-MM-dd"))"}'
            hx-headers='{"x-dw-template": "/Designs/Swift-v2/Paragraph/Swift-v2_Dashboard_Number/Numbers/MonthlySpent.cshtml", "accept": "text/html", "x-dw-culture": "@(Pageview?.Area?.CultureInfo?.Name)"}'
            hx-vals='{"ShowPricesWithVat": "@(Dynamicweb.Ecommerce.Common.Context.DisplayPricesWithVat)"}'
            hx-ext="swift-auth"
            hx-trigger="tokenFetched.swift.authentication from:body"
            hx-swap="innerHTML">
            <div class="hstack gap-3 placeholder-glow py-3">
                <div class="placeholder bg-primary-subtle rounded-pill w-100" style="max-width: 35px;"></div>
            </div>
        </div>
    </div>
</div>