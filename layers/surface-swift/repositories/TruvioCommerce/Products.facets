<?xml version="1.0" encoding="utf-8"?>
<!--
  TruvioCommerce/Products.facets — the storefront facet set.

  THREE FACETS, and no more, on purpose. Every facet here binds a BASE-SCHEMA field, so it
  populates on any catalogue the distribution ships. The host's own ProductsFrontend facet
  file still declares more than a dozen facets bound to the stock demo catalogue's category
  fields; on any other catalogue those render as empty rails, which is the failure this
  file exists to avoid. A facet whose field has no values is worse than a missing facet:
  it renders, occupies the rail and filters nothing.

  Each facet's QueryParameter must name a Parameter that exists in Products.query, and its
  Field must name a SystemName that exists in Products.index. All three files move together
  or the facet is decorative.

  A NOTE ON THE MISSING REPOSITORY FAILURE MODE. If this repository is not staged before
  host start, the storefront does not return 5xx — it returns HTTP 200 with an in-page
  Lucene error ("numHits must be > 0"). Never assert a repository by status code.

  FILL-IN RECIPE — a category-field facet (checkbox):
    <Facet Name="Material" Type="Field" Field="PropMaterial" QueryParameter="PropMaterial">
      <RenderType Name="Checkboxes" SystemName="Checkboxes" />
      <Visibility Status="AlwaysVisible" QueryParameter="" Condition="HasValue" MatchValue="" />
    </Facet>
  and a RANGE facet, for a numeric category field (the render type that needs a numeric
  index field, not a string one):
    <Facet Name="Operating temperature" Type="Field" Field="OperatingTemp" QueryParameter="OperatingTemp">
      <RenderType Name="Range" SystemName="Range" />
      <Visibility Status="AlwaysVisible" QueryParameter="" Condition="HasValue" MatchValue="" />
    </Facet>
  Each needs its Field in Products.index (Source ProductCategory|<Category>|<Field>,
  SkipCategoryFields False) and its Parameter plus a MatchAny expression in Products.query.
-->
<Facets Name="Products.facets">
  <Settings />
  <Source Repository="TruvioCommerce" Item="Products.query" />
  <Meta />
  <Facet Name="Group" Type="Field" Field="ParentGroupIDs" QueryParameter="GroupID">
    <RenderType Name="Checkboxes" SystemName="Checkboxes" />
    <Visibility Status="AlwaysVisible" QueryParameter="" Condition="HasValue" MatchValue="" />
  </Facet>
  <Facet Name="Price" Type="Field" Field="PriceRange" QueryParameter="PriceRange">
    <RenderType Name="Checkboxes" SystemName="Checkboxes" />
    <Visibility Status="AlwaysVisible" QueryParameter="" Condition="HasValue" MatchValue="" />
  </Facet>
  <Facet Name="Manufacturer" Type="Field" Field="Manufacturer_Facet" QueryParameter="Manufacturer">
    <RenderType Name="Checkboxes" SystemName="Checkboxes" />
    <Visibility Status="AlwaysVisible" QueryParameter="" Condition="HasValue" MatchValue="" />
  </Facet>
</Facets>
