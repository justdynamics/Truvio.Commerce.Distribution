{
  "outputDirectory": "Serializer",
  "replaceOutputSubfolder": "replace",
  "mergeOutputSubfolder": "merge",
  "predicates": [
    {
      "name": "EcomCountries",
      "mode": "Replace",
      "providerType": "SqlTable",
      "table": "EcomCountries",
      "serviceCaches": [
        "Dynamicweb.Ecommerce.International.CountryRelationService",
        "Dynamicweb.Ecommerce.International.CountryService"
      ]
    },
    {
      "name": "EcomCountryText",
      "mode": "Replace",
      "providerType": "SqlTable",
      "table": "EcomCountryText",
      "serviceCaches": [
        "Dynamicweb.Ecommerce.International.CountryService"
      ]
    },
    {
      "name": "EcomCurrencies",
      "mode": "Replace",
      "providerType": "SqlTable",
      "table": "EcomCurrencies",
      "serviceCaches": [
        "Dynamicweb.Ecommerce.International.CurrencyService"
      ]
    },
    {
      "name": "EcomLanguages",
      "mode": "Replace",
      "providerType": "SqlTable",
      "table": "EcomLanguages",
      "serviceCaches": [
        "Dynamicweb.Ecommerce.International.LanguageService"
      ]
    },
    {
      "name": "EcomVatGroups",
      "mode": "Replace",
      "providerType": "SqlTable",
      "table": "EcomVatGroups",
      "nameColumn": "VatGroupName",
      "serviceCaches": [
        "Dynamicweb.Ecommerce.International.VatGroupService"
      ]
    },
    {
      "name": "EcomVatCountryRelations",
      "mode": "Replace",
      "providerType": "SqlTable",
      "table": "EcomVatCountryRelations",
      "serviceCaches": [
        "Dynamicweb.Ecommerce.International.VatGroupCountryRelationService"
      ]
    },
    {
      "name": "EcomShops",
      "mode": "Replace",
      "providerType": "SqlTable",
      "table": "EcomShops"
    },
    {
      "name": "EcomShopLanguageRelation",
      "mode": "Replace",
      "providerType": "SqlTable",
      "table": "EcomShopLanguageRelation"
    },
    {
      "name": "EcomShopGroupRelation",
      "mode": "Replace",
      "providerType": "SqlTable",
      "table": "EcomShopGroupRelation"
    },
    {
      "name": "EcomStockLocation",
      "mode": "Replace",
      "providerType": "SqlTable",
      "table": "EcomStockLocation",
      "_why": "Replace, whole table: the stock locations are framework configuration, not catalogue. The baseline DB shipped the Swift demo's own rows (1 'BikeShop Copenhagen', 2 'BikeShop Aarhus', 3 'Default stock location'), so every composed edition carried a bike shop's warehouse names. The base now owns the table outright with neutral names on the SAME ids 1-3: the sample-data layer's EcomStockUnit rows and EcomShops.ShopStockLocationID reference those ids, so a rekey would orphan them (Foundry #1303). Replace rather than Merge so a re-deserialize restores the neutral set instead of leaving a previously delivered bike-shop name in place."
    },
    {
      "name": "Reference category",
      "mode": "Replace",
      "providerType": "SqlTable",
      "table": "EcomProductCategory",
      "where": "CategoryId = 'reference_category'",
      "_why": "Replace, filtered to the ONE hidden template category Dynamicweb's completeness-rule and category-field admin UI reads (CategoryType 2). BASE.md has claimed this row since 3.0.0 and it never shipped - the Foundry gate synthesised it as Step 3b instead (tools/harness/Invoke-SeedVerify.ps1, DemoVerifier Check 2), which means a consumer deserializing the Distribution without the gate never got it (Foundry #1304). Filtered, never whole-table: the tc_* concrete categories are sample-data-owned merge rows and a whole-table Replace here would wipe them."
    },
    {
      "name": "Reference category translation",
      "mode": "Replace",
      "providerType": "SqlTable",
      "table": "EcomProductCategoryTranslation",
      "where": "CategoryTranslationCategoryId = 'reference_category'",
      "_why": "Replace, filtered to the reference_category rows only, for the same reason as the parent predicate: the ENU display name 'Reference category' ships with the row it belongs to, while the tc_* translations stay sample-data-owned merge rows. The Foundry gate's own seed is IF NOT EXISTS-guarded on the category id, so a gated host that already carries a LANG1 row is unaffected (Foundry #1304)."
    },
    {
      "name": "EcomPayments",
      "mode": "Replace",
      "providerType": "SqlTable",
      "table": "EcomPayments",
      "nameColumn": "PaymentName",
      "xmlColumns": [
        "PaymentGatewayParameters",
        "PaymentCheckoutParameters"
      ],
      "serviceCaches": [
        "Dynamicweb.Ecommerce.Orders.PaymentService"
      ]
    },
    {
      "name": "EcomShippings",
      "mode": "Replace",
      "providerType": "SqlTable",
      "table": "EcomShippings",
      "nameColumn": "ShippingName",
      "xmlColumns": [
        "ShippingServiceParameters"
      ],
      "serviceCaches": [
        "Dynamicweb.Ecommerce.Orders.ShippingService"
      ]
    },
    {
      "name": "EcomMethodCountryRelation",
      "mode": "Replace",
      "providerType": "SqlTable",
      "table": "EcomMethodCountryRelation"
    },
    {
      "name": "EcomOrderFlow",
      "mode": "Replace",
      "providerType": "SqlTable",
      "table": "EcomOrderFlow",
      "nameColumn": "OrderFlowName"
    },
    {
      "name": "EcomOrderStates",
      "mode": "Replace",
      "providerType": "SqlTable",
      "table": "EcomOrderStates",
      "nameColumn": "OrderStateName"
    },
    {
      "name": "EcomOrderStateRules",
      "mode": "Replace",
      "providerType": "SqlTable",
      "table": "EcomOrderStateRules"
    },
    {
      "name": "Customer center user groups",
      "mode": "Replace",
      "providerType": "SqlTable",
      "table": "AccessUser",
      "where": "AccessUserType = 2 AND AccessUserName IN ('Customers','Account Admin','CSR')",
      "nameColumn": "AccessUserName"
    }
  ]
}
